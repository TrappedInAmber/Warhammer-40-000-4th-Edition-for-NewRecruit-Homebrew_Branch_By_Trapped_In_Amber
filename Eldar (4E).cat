      </profiles>
      <rules>
        <rule name="Divination" id="c35b-5e5a-b2d6-0434" hidden="false">
          <description>After both sides have deployed at the start of a game, the Eldar player may reposition D3+1 units in his army. No unit may be moved outside of its deployment zone.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Staff of Ulthamar" id="f837-fe5a-a636-bfa4" hidden="false" import="true" sortIndex="2" type="upgrade">
          <profiles>
            <profile name="Staff of Ulthamar" id="78d0-ffb3-dba2-231e" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
              <characteristics>
                <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">If Eldrad is not in an assault, the Staff allows Eldrad to use a third psychic power per turn, which may be a psychic power he has already used that turn. If used as a close combat weapon it always wounds on a roll of 2+ and ignores Armour Saves.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Warlock Council" id="1168-3362-bad8-0727" hidden="false" import="true" sortIndex="10" type="unit">
          <entryLinks>
            <entryLink name="Warlock" id="beb8-ae9d-21e4-338b" hidden="false" import="true" targetId="e327-30c2-1b34-86e0" type="selectionEntry">
