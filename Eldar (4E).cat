              </costs>
              <modifiers>
                <modifier field="d25b-ade2-3bc9-9e30" type="set" value="1">
                  <conditions>
                    <condition childId="d4b4-b1e7-a460-538c" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Defend" id="dcf7-652b-cb41-0748" hidden="false">
                  <description>Enemy models directing their attacks towards the Exarch&apos;s squad lose one Attack in each Assault phase (to a minimum of 1).</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
