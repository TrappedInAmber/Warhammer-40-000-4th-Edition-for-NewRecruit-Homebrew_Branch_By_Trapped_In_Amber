          <characteristics>
            <characteristic name="Details" typeId="acf3-d214-6e51-29fe">This is a one-handed weapon that adds +1S to the model&apos;s attacks.
In NewRecruit this modifier is applied to the profile automatically.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Laser Lance" id="49bc-df0a-011c-352e" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Laser Lance" id="2564-8906-4e30-ec3c" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
