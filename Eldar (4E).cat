              <rules>
                <rule name="Bladestorm" id="dd67-154d-adf0-3f53" hidden="false">
                  <description>The Exarch and his squad may choose to add one to the number of shots they each fire with their shuriken weapons that turn. If they do so they may not fire in the subsequent shooting phase as they reload.</description>
                </rule>
              </rules>
            </selectionEntry>
