    <selectionEntry name="Swooping Hawk Wings" id="7850-c835-379a-65b7" hidden="false" import="true" type="upgrade">
      <infoLinks>
        <infoLink name="Deep Strike" id="fb1e-16f8-0b10-6e94" hidden="false" targetId="bbf5-b1c2-49b0-f3c2" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier affects="profiles.Unit" field="556e6974205479706523232344415441232323" scope="parent" type="set" value="Jump Infantry"/>
      </modifiers>
      <profiles>
        <profile name="Swooping Hawk Wings" id="be7e-6a63-c186-7e9b" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A model with Swooping Hawk Wings moves as if it is equipped with a jump pack and may use the Deep Strike rules to deploy in mission that allow it.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Warp Jump Generator" id="bef0-20db-c81b-34e9" hidden="false" import="true" type="upgrade">
      <modifiers>
        <modifier affects="profiles.Unit" field="556e6974205479706523232344415441232323" scope="parent" type="set" value="Jump Infantry"/>
      </modifiers>
      <profiles>
        <profile name="Warp Jump Generator" id="fb44-0eea-e221-818e" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A unit with warp jump generators moves as if it was equipped with jump packs. If unengaged, the unit may make a second jump during the assault phase instead of assaulting. Nominate the direction the unit is jumping in and move it up to 2D6&quot; in this direction. Any model finishing its move in impassable terrain is destroyed. If you roll a double, one member of the unit has been claimed by the Warp and is removed as a casualty (the survivors move up to the distance rolled, following the normal rules for jump infantry).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Banshee Mask" id="59d2-1bb9-de96-5735" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Banshee Mask" id="f469-6742-dd9b-7951" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">In the first round of an assault a model wearing a Banshee mask has Initiative 10 and negates any Initiative bonus conferred by cover and grenades.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Mandiblasters" id="41ca-9261-39bf-da26" hidden="false" import="true" type="upgrade">
      <modifiers>
        <modifier affects="self.entries.profiles.Unit" field="4.123232344415441e+21" scope="parent" type="increment" value="1"/>
