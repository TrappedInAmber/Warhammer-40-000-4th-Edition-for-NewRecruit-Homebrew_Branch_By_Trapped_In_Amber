          <profiles>
            <profile name="Vectored Engines" id="dbc1-f5ee-5c75-0c74" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
              <characteristics>
                <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">If the vehicle would crash due to being immobilised, it instead makes a forced landing as if it had not moved that turn.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
