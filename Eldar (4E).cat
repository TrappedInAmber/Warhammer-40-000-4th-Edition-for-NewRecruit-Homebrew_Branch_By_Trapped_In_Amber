            <selectionEntry name="Skyleap" id="8217-f882-8376-4c18" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="dd78-2f8d-b0e9-d497" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="7eea-e474-197e-2d48" automatic="true" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="0"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="15"/>
              </costs>
              <modifiers>
                <modifier field="7eea-e474-197e-2d48" type="set" value="1">
                  <conditions>
                    <condition childId="d4b4-b1e7-a460-538c" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Skyleap" id="4f32-4d8e-4814-45b8" hidden="false">
                  <description>The player may elect to remove a unit with Skyleap form the table in its Movement phase, placing it in Reserve. If the squad was engaged in combat, the enemy may make a 3&quot; consolidation move. The squad may then Deep Strike back into play from their following turn, exactly if they had been held in reserve from the beginning of the game (even in missions that do not allow Deep Strike or reserves). For example, if they are removed from the table on turn 2, they will re-enter play on turn 3 on a roll of a 3+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Intercept" id="444c-1c57-3f1f-344c" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7f8c-700e-f7d4-8da0" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="c11d-e54c-a80e-56d4" automatic="true" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="0"/>
              </constraints>
              <costs>
                <cost name="Points" typeId="4deb-313d-6685-f48b" value="5"/>
              </costs>
              <modifiers>
                <modifier field="c11d-e54c-a80e-56d4" type="set" value="1">
                  <conditions>
                    <condition childId="d4b4-b1e7-a460-538c" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Intercept" id="1095-46e6-e232-28d1" hidden="false">
                  <description>In assault, the Exarch and his squad never require worse than a 4+ to hit a vehicle.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
