          <profiles>
            <profile name="Spirit Stones" id="fd67-48bf-c74f-66b0" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
              <characteristics>
                <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">If the vehicle suffers a &apos;crew stunned&apos; result it is automatically counted as a &apos;crew shaken&apos; result instead.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vectored Engines" id="1c92-a2c7-6e36-318a" hidden="false" import="true" sortIndex="1" type="upgrade">
